<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.malabespareparts.controller.DashboardController">
   <children>
      <BorderPane prefHeight="200.0" prefWidth="250.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <left>
            <VBox prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
               <children>
                  <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="180.0" text="Dashboard" />
                  <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="180.0" text="Inventory" />
                  <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="180.0" text="Dealers" />
                  <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="180.0" text="POS Checkout" />
                  <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="180.0" text="Audit Log" />
                  <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="180.0" text="Exit" />
               </children>
            </VBox>
         </left>
         <top>
            <HBox prefHeight="60.0" prefWidth="200.0" BorderPane.alignment="CENTER_LEFT">
               <padding>
                  <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
               </padding>
               <children>
                  <Label text="Malabe Spare Parts Management System" textAlignment="CENTER">
                     <font>
                        <Font size="22.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
         </top>
         <center>
            <VBox prefHeight="390.0" prefWidth="522.0" spacing="10.0" BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <HBox prefHeight="39.0" prefWidth="566.0">
                     <children>
                        <Label text="Keyword Search" />
                        <TextField fx:id="keywordField"
                                   prefHeight="25.0"
                                   prefWidth="129.0"/>
                        <Label text="Category" />
                        <ComboBox fx:id="categoryComboBox" prefHeight="25.0" prefWidth="131.0" />
                        <Label text="Min Price" />
                        <TextField fx:id="minPriceField" prefHeight="25.0" prefWidth="119.0" />
                        <Label text="Max Price" />
                        <TextField fx:id="maxPriceField" prefHeight="25.0" prefWidth="132.0" />
                     </children>
                  </HBox>
                  <TableView fx:id="inventoryTable" prefHeight="200.0" prefWidth="730.0">
                     <columns>
                        <TableColumn fx:id="partCodeColumn" prefWidth="118.0" text="Part Code" />
                        <TableColumn fx:id="descriptionColumn" prefWidth="157.0" text="Description" />
                        <TableColumn fx:id="brandColumn" prefWidth="75.0" text="Brand" />
                        <TableColumn fx:id="priceColumn" prefWidth="65.0" text="Price" />
                        <TableColumn fx:id="qtyColumn" prefWidth="87.0" text="Qty" />
                        <TableColumn fx:id="categoryColumn" prefWidth="85.0" text="Category" />
                        <TableColumn fx:id="lastUpdatedColumn" prefWidth="100.0" text="Last Updated" />
                     </columns>
                  </TableView>
                  <HBox prefHeight="100.0" prefWidth="200.0" />
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
